<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">	
	<Styles.Resources>
		<ResourceDictionary>
			<x:String x:Key="CheckBoxCheckedGlyph">&#xE10B;</x:String>

			<!-- Colors -->
			<Color x:Key="BackgroundBrush">#4a5942</Color>
			<Color x:Key="SecondaryBackgroundBrush">#3e4637</Color>
			<Color x:Key="ThirdBackgroundBrush">#869081</Color>

			<Color x:Key="AccentBrush">#c4b550</Color>
			<Color x:Key="SecondaryAccentBrush">#958831</Color>
			<Color x:Key="FadeAccentBrush">#9C935A</Color>

			<Color x:Key="TextBrush">#dedfd6</Color>
			<Color x:Key="SecondaryTextBrush">#d8ded3</Color>
			<Color x:Key="Text3Brush">#a0aa95</Color>

			<Color x:Key="BorderLightBrush">#8c9284</Color>
			<Color x:Key="BorderDarkBrush">#292c21</Color>

			<Color x:Key="DisabledTextBrush">#292c21</Color>
			<Color x:Key="DisabledTextShadowBrush">#75806f</Color>

			<Color x:Key="OutlineBrush">#000</Color>
			<Color x:Key="SliderBrush">#7f8c7f</Color>
			<Color x:Key="SliderBackgroundBrush">#1f1f1f</Color>

			<Color x:Key="ScrollbarTrackBrush">#5a6a50</Color>

			<FontFamily x:Key="Gohu">avares://cs16AvaloniaTheme/Assets/Fonts/Gohu/GohuFontuni14NerdFontPropo-Regular.ttf#Gohu</FontFamily>

			<StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="CircleElevationBorderBrush" />
			<SolidColorBrush x:Key="CircleElevationBorderBrush" Color="{DynamicResource SecondBackgroundBrush}" />

			<StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
			<SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{DynamicResource AccentBrush}" />

			<StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="AccentFillColorDefaultBrush" />
			<LinearGradientBrush x:Key="AccentFillColorDefaultBrush" StartPoint="70%,90%" EndPoint="10%,40%">
				<LinearGradientBrush.GradientStops>
					<GradientStop Offset="0.50" Color="{StaticResource BorderLightBrush}"/>
					<GradientStop Offset="0.50" Color="{StaticResource BorderDarkBrush}"/>
				</LinearGradientBrush.GradientStops>
			</LinearGradientBrush>

			<SolidColorBrush x:Key="ComboBoxItemForeground" Color="{DynamicResource TextBrush}" />
			<SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource AccentBrush}" />
			<SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="{DynamicResource AccentBrush}" />

			<SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor" Color="{DynamicResource AccentBrush}" />
			<x:Double x:Key="DataGridRowHoveredBackgroundColorOpacity">0.2</x:Double>
			<SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{DynamicResource AccentBrush}" />
			<x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.4</x:Double>
			<SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="{DynamicResource AccentBrush}" />
			<x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.4</x:Double>
			<SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{DynamicResource AccentBrush}" />
			<x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.4</x:Double>

			<SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{DynamicResource Text3Brush}" />
			<SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{DynamicResource BackgroundBrush}" />

			<!-- Colors -->
			<Color x:Key="GrayAsparagus">#4a5942</Color>
			<Color x:Key="CabbagePont">#3e4637</Color>
			<Color x:Key="Stack">#869081</Color>

			<Thickness x:Key="ButtonPadding">6</Thickness>
			<Thickness x:Key="CheckBoxPadding">4</Thickness>
			<Thickness x:Key="TextControlThemePadding">4 8 4 4</Thickness>

			<x:Double x:Key="RowHeight">27</x:Double>
			<x:Double x:Key="MainFontSize">12</x:Double>
		</ResourceDictionary>
	</Styles.Resources>
</Styles>
